---
import DefaultFooter from '@astrojs/starlight/components/Footer.astro';
const german = Astro.url.pathname.startsWith('/de/');
const p = german ? '/de' : '';
---

<DefaultFooter><slot /></DefaultFooter>

<nav class="legal-footer" aria-label={german ? 'Rechtliche Informationen' : 'Legal information'}>
  <a href={`${p}/impressum/`}>{german ? 'Impressum' : 'Imprint'}</a>
  <a href={`${p}/datenschutz/`}>{german ? 'Datenschutz' : 'Privacy policy'}</a>
  <a href={`${p}/markenhinweise/`}>{german ? 'Markenhinweise' : 'Trademarks & credits'}</a>
  <span>OpenSigWeave · {german ? 'Unabhängiges Open-Source-Projekt' : 'Independent open-source project'}</span>
</nav>

<style>
  .legal-footer {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem 1.4rem;
    margin-block: 1rem 2rem;
    padding-block: 1rem;
    border-top: 1px solid var(--sl-color-hairline);
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
  }
  .legal-footer a {
    color: var(--sl-color-text-accent);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .legal-footer a:hover,
  .legal-footer a:focus-visible {
    color: var(--sl-color-white);
  }
  .legal-footer span { margin-inline-start: auto; }
  @media (max-width: 50rem) {
    .legal-footer span { margin-inline-start: 0; width: 100%; }
  }
</style>
